<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.22621.38</WindowsSdkPackageVersion>
    <RootNamespace>Mixr</RootNamespace>
    <!-- CsWinRT-Source-Generator (Windows-TFM) erzeugt unsafe-Code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- InputSimulator 1.0.4 ist ein .NET-Framework-Paket (NU1701) — läuft unter .NET 9, Ersatz steht auf der Roadmap. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <!-- USB-HID-Zugriff auf das Mixr (Vendor-Interface) — treiberlos, kein COM-Port -->
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="InputSimulator" Version="1.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.3" />
    <PackageReference Include="System.IO.Ports" Version="10.0.3" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
