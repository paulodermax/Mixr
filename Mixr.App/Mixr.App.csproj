<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.22621.38</WindowsSdkPackageVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Mixr_App</RootNamespace>
    <AssemblyName>Mixr</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Vertriebsmodell: unpackaged + self-contained, ausgeliefert über Velopack (Setup.exe + Delta-Updates
      aus GitHub Releases). Kein MSIX, keine Paket-Identität. Die Windows App Runtime liegt im App-Ordner
      (Undocked RegFree WinRT); der Bootstrapper darf deshalb NICHT laufen, sonst sucht er die MSIX-Runtime.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Ohne EnableMsixTooling scheitert `dotnet build` in der PRI-Generierung (ExpandPriContent) — auch für unpackaged Apps nötig. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>

    <!-- System.Drawing.Common 10.x (NotifyIcon) asks for Metadata/Immutable v10; net9 ref is v9 — harmless, primary wins -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <!-- Eigenes Program.cs (Velopack-Hooks + Logging vor XAML) statt generiertem Main -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Mixr-Modell.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\general-sound.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\no-input.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240829007" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mixr.Core\Mixr.Core.csproj" />
  </ItemGroup>

  <!-- Default-Konfiguration: wird beim ersten Start nach %LOCALAPPDATA%\Mixr\config.yaml kopiert. -->
  <ItemGroup>
    <None Include="..\Mixr.Core\config.yaml" Link="config.default.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="config.secrets.example.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Cover-Assets: Repository Mixr/covers → Ausgabe covers\; Start → %LocalAppData%\Mixr\covers -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\covers')">
    <Content Include="$(MSBuildProjectDirectory)\..\covers\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>covers\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!--
    Firmware-Image für das Geräte-Update: die Release-Pipeline legt ESP/build/Mixr.bin nach
    Mixr.App/firmware/Mixr.bin, bevor sie publiziert. Lokal optional (Ordner darf fehlen).
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\firmware')">
    <Content Include="$(MSBuildProjectDirectory)\firmware\*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>firmware\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
