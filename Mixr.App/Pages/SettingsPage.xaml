<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Mixr_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="22"
                FontWeight="SemiBold"
                Text="Settings" />

            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Windows" />
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Header="Start with Windows"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="StartupToggle_Toggled" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Adds a Run entry for this app (Registry Run)."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Audio" />
                    <CheckBox
                        x:Name="LimitSystemSoundsCheck"
                        Content="Limit system sounds to 20% (notifications)"
                        Checked="LimitSystemSoundsCheck_Changed"
                        Unchecked="LimitSystemSoundsCheck_Changed" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Checked once at app start: if Windows “System Sounds” is louder than 20%, it is reduced."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Edit configuration" />
                    <TextBlock
                        x:Name="CfgHint"
                        Margin="0,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton Content="Open folder" Click="OpenFolder_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
