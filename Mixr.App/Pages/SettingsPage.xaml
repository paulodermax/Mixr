<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Mixr_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720">
            <TextBlock
                Margin="0,0,0,16"
                FontSize="22"
                FontWeight="SemiBold"
                Text="Einstellungen" />

            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12" FontWeight="SemiBold" Text="Windows" />
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Header="Mit Windows starten"
                        OffContent="Aus"
                        OnContent="Ein"
                        Toggled="StartupToggle_Toggled" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Schreibt einen Eintrag unter „Anmeldung“ (Registry Run)."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Konfiguration bearbeiten" />
                    <TextBlock
                        x:Name="CfgHint"
                        Margin="0,0,0,8"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton Content="Ordner öffnen" Click="OpenFolder_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
