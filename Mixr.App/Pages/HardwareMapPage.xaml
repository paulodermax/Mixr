<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.HardwareMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Schematic: full area below navigation -->
        <Grid x:Name="SchematicRoot" Padding="8">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SchematicSlideTransform" />
            </Grid.RenderTransform>
            <Viewbox
                x:Name="SchematicViewbox"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="Uniform">
                <Canvas Width="1023" Height="792">
                    <Image x:Name="SchematicImage" Width="1023" Height="792" />

                    <Grid
                        Canvas.Left="420"
                        Canvas.Top="242"
                        Width="58"
                        Height="504"
                        Background="Transparent"
                        PointerEntered="Hotspot_PointerEntered"
                        PointerExited="Hotspot_PointerExited"
                        Tapped="Hotspot_Tapped"
                        Tag="f0">
                        <Border
                            x:Name="GlowF0"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid
                        Canvas.Left="571"
                        Canvas.Top="242"
                        Width="58"
                        Height="504"
                        Background="Transparent"
                        PointerEntered="Hotspot_PointerEntered"
                        PointerExited="Hotspot_PointerExited"
                        Tapped="Hotspot_Tapped"
                        Tag="f1">
                        <Border
                            x:Name="GlowF1"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid
                        Canvas.Left="722"
                        Canvas.Top="242"
                        Width="58"
                        Height="504"
                        Background="Transparent"
                        PointerEntered="Hotspot_PointerEntered"
                        PointerExited="Hotspot_PointerExited"
                        Tapped="Hotspot_Tapped"
                        Tag="f2">
                        <Border
                            x:Name="GlowF2"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid
                        Canvas.Left="873"
                        Canvas.Top="242"
                        Width="58"
                        Height="504"
                        Background="Transparent"
                        PointerEntered="Hotspot_PointerEntered"
                        PointerExited="Hotspot_PointerExited"
                        Tapped="Hotspot_Tapped"
                        Tag="f3">
                        <Border
                            x:Name="GlowF3"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>

                    <Grid
                        Canvas.Left="61"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                        PointerEntered="Hotspot_PointerEntered"
                        PointerExited="Hotspot_PointerExited"
                        Tapped="Hotspot_Tapped"
                        Tag="b0">
                        <Border
                            x:Name="GlowB0"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid
                        Canvas.Left="209"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                        PointerEntered="Hotspot_PointerEntered"
                        PointerExited="Hotspot_PointerExited"
                        Tapped="Hotspot_Tapped"
                        Tag="b1">
                        <Border
                            x:Name="GlowB1"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid
                        Canvas.Left="359"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                        PointerEntered="Hotspot_PointerEntered"
                        PointerExited="Hotspot_PointerExited"
                        Tapped="Hotspot_Tapped"
                        Tag="b2">
                        <Border
                            x:Name="GlowB2"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid
                        Canvas.Left="559"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                        PointerEntered="Hotspot_PointerEntered"
                        PointerExited="Hotspot_PointerExited"
                        Tapped="Hotspot_Tapped"
                        Tag="b3">
                        <Border
                            x:Name="GlowB3"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid
                        Canvas.Left="708"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                        PointerEntered="Hotspot_PointerEntered"
                        PointerExited="Hotspot_PointerExited"
                        Tapped="Hotspot_Tapped"
                        Tag="b4">
                        <Border
                            x:Name="GlowB4"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                </Canvas>
            </Viewbox>
        </Grid>

        <Border
            x:Name="DetailDrawer"
            Width="380"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DetailSlideTransform" />
            </Border.RenderTransform>
            <Grid Padding="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="DetailTitleText"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        Grid.Column="1"
                        Padding="10,6"
                        Click="DetailClose_Click"
                        Content="Close"
                        Style="{StaticResource DefaultButtonStyle}" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
                    <Grid>
                        <StackPanel x:Name="SliderDetailPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Audio group (key)" />
                            <TextBox
                                x:Name="DetailSliderGroup"
                                PlaceholderText="e.g. communication" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Search strings (one line per entry)" />
                            <TextBox
                                x:Name="DetailSliderPrograms"
                                MinHeight="180"
                                AcceptsReturn="True"
                                PlaceholderText="App or window title"
                                TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Click="DetailSaveSlider_Click"
                                Content="Save"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="ButtonDetailPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock
                                Text="Action on press (button_mapping in config.yaml)"
                                TextWrapping="WrapWholeWords"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="DetailButtonCombo" HorizontalAlignment="Stretch" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Click="DetailSaveButton_Click"
                                Content="Save"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
