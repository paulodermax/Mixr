<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,16,28,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.15*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Links: Status, Display-Spiegel, Version -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Home" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border
                        x:Name="AppStatusDot"
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        CornerRadius="5" />
                    <TextBlock
                        x:Name="AppStatusText"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="App: Online" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border
                        x:Name="BoardStatusDot"
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        CornerRadius="5" />
                    <TextBlock
                        x:Name="BoardStatusText"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Board: —" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border
                        x:Name="LibraryStatusDot"
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        CornerRadius="5" />
                    <TextBlock
                        x:Name="LibraryStatusText"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Library: —" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,16,0,12" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="SlidePrevButton"
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SlidePrev_Click"
                    ToolTipService.ToolTip="Vorherige Display-Seite">
                    <FontIcon FontSize="16" Glyph="&#xE76B;" />
                </Button>

                <Border
                    Grid.Column="1"
                    Width="200"
                    Height="446"
                    Margin="8,0"
                    Background="#FF0A0A0A"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Slide 0: Now Playing -->
                        <Grid x:Name="SlideNowPlaying" Margin="12,16,12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Width="168"
                                Height="168"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource MixrSubtleFillBrush}"
                                CornerRadius="8">
                                <Image
                                    x:Name="MirrorCover"
                                    Stretch="UniformToFill" />
                            </Border>
                            <TextBlock
                                x:Name="MirrorTitle"
                                Grid.Row="1"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="—"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                x:Name="MirrorArtist"
                                Grid.Row="2"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Keine Wiedergabe"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <StackPanel
                                Grid.Row="3"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Bottom">
                                <Border
                                    x:Name="MirrorMuteChip"
                                    Padding="8,4"
                                    Background="{ThemeResource MixrSubtleFillBrush}"
                                    CornerRadius="6"
                                    Opacity="0.35">
                                    <TextBlock FontSize="10" Text="Mute" />
                                </Border>
                                <Border
                                    x:Name="MirrorDeafenChip"
                                    Padding="8,4"
                                    Background="{ThemeResource MixrSubtleFillBrush}"
                                    CornerRadius="6"
                                    Opacity="0.35">
                                    <TextBlock FontSize="10" Text="Deafen" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Slide 1: Focus -->
                        <Grid x:Name="SlideFocus" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Focus" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    FontSize="42"
                                    FontWeight="SemiLight"
                                    Text="25:00" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{ThemeResource MixrAccentBrush}"
                                    Text="Start" />
                            </StackPanel>
                        </Grid>

                        <!-- Slide 2: Mixer -->
                        <Grid x:Name="SlideMixer" Margin="16,24" Visibility="Collapsed">
                            <StackPanel Spacing="14" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Mixer" />
                                <StackPanel x:Name="MirrorMixerBars" Spacing="10" />
                            </StackPanel>
                        </Grid>

                        <!-- Slide 3: Settings grid -->
                        <Grid x:Name="SlideSettings" Margin="16,28,16,8" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Einstellungen" />
                            <Border Grid.Row="1" Grid.Column="0" Margin="4" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Text="Back" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Margin="4" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Text="Hardware" />
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Margin="4" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Text="Helligkeit" />
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Margin="4" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="—" />
                            </Border>
                            <Border Grid.Row="3" Grid.Column="0" Margin="4" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Text="Debug" />
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Margin="4" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Text="Neustart" />
                            </Border>
                        </Grid>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Ellipse x:Name="Pager0" Width="7" Height="7" Fill="{ThemeResource MixrAccentBrush}" />
                            <Ellipse x:Name="Pager1" Width="7" Height="7" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.4" />
                            <Ellipse x:Name="Pager2" Width="7" Height="7" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.4" />
                            <Ellipse x:Name="Pager3" Width="7" Height="7" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.4" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button
                    x:Name="SlideNextButton"
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SlideNext_Click"
                    ToolTipService.ToolTip="Nächste Display-Seite">
                    <FontIcon FontSize="16" Glyph="&#xE76C;" />
                </Button>
            </Grid>

            <TextBlock
                x:Name="VersionLine"
                Grid.Row="2"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Version: —" />
        </Grid>

        <!-- Rechts: Fader + Logs -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <Border
                    x:Name="FaderRow0"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                            <Image x:Name="FaderIcon0" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="FaderLabel0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Grid x:Name="FaderTrack0" Height="8">
                                <Border Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="4" />
                                <Border
                                    x:Name="FaderFill0"
                                    Width="40"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MixrAccentBrush}"
                                    CornerRadius="4" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border
                    x:Name="FaderRow1"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                            <Image x:Name="FaderIcon1" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="FaderLabel1" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Grid x:Name="FaderTrack1" Height="8">
                                <Border Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="4" />
                                <Border
                                    x:Name="FaderFill1"
                                    Width="40"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MixrAccentBrush}"
                                    CornerRadius="4" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border
                    x:Name="FaderRow2"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                            <Image x:Name="FaderIcon2" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="FaderLabel2" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Grid x:Name="FaderTrack2" Height="8">
                                <Border Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="4" />
                                <Border
                                    x:Name="FaderFill2"
                                    Width="40"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MixrAccentBrush}"
                                    CornerRadius="4" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border
                    x:Name="FaderRow3"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="8">
                            <Image x:Name="FaderIcon3" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="FaderLabel3" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Grid x:Name="FaderTrack3" Height="8">
                                <Border Background="{ThemeResource MixrSubtleFillBrush}" CornerRadius="4" />
                                <Border
                                    x:Name="FaderFill3"
                                    Width="40"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MixrAccentBrush}"
                                    CornerRadius="4" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Border
                Grid.Row="1"
                Margin="0,12,0,0"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Gefilterte Logs" />
                        <Button
                            x:Name="OpenLogButton"
                            Width="32"
                            Height="28"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OpenLog_Click"
                            ToolTipService.ToolTip="Log-Datei öffnen">
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </Button>
                    </Grid>
                    <ScrollViewer
                        x:Name="LogScroller"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="FilteredLogText"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
