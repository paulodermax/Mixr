<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Text="Overview" />
            <TextBlock
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Faders, Windows audio, and configuration at a glance."
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <!-- Widget-Zeile -->
        <Grid
            Grid.Row="1"
            Margin="0,28,0,0"
            VerticalAlignment="Top"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Status -->
            <Border
                Padding="20,18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            VerticalAlignment="Center"
                            Background="{ThemeResource MixrAccentBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="STATUS" />
                    </StackPanel>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Ready" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="H/S active"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <!-- Konfiguration -->
            <Border
                Grid.Column="1"
                Padding="20,18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            VerticalAlignment="Center"
                            Background="{ThemeResource MixrAccentBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="CONFIGURATION" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ConfigFileNameText"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="config.yaml"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ConfigPathText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        MaxLines="3"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Sliders -->
            <Border
                Grid.Column="2"
                Padding="20,18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="3"
                            Height="18"
                            VerticalAlignment="Center"
                            Background="{ThemeResource MixrAccentBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="SLIDERS" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Assign apps to the four sliders and save."
                        TextWrapping="WrapWholeWords" />
                    <Button
                        MinHeight="40"
                        Padding="16,10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Click="OpenSliderMapping_Click"
                        Content="Slider-Editing"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
