<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.SliderMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Mixr_App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="AssignedCoverTemplate">
            <Border
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                Loaded="AssignedCover_Loaded"
                PointerEntered="AssignedCover_PointerEntered"
                PointerExited="AssignedCover_PointerExited">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <Grid Height="58">
                    <Border
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Border
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource MixrSubtleFillBrush}"
                                CornerRadius="8"
                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="6,2"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Token}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="WrapWholeWords" />
                            </Border>
                            <Border CornerRadius="8">
                                <Image
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Source="{Binding Cover}"
                                    Stretch="UniformToFill"
                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                            </Border>
                        </Grid>
                    </Border>
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="2,0,2,0"
                        Padding="4,2"
                        MinWidth="26"
                        MinHeight="26"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="Zuordnung entfernen"
                        Click="RemoveAssigned_Click"
                        Content="✕"
                        FontSize="11"
                        Opacity="0.55"
                        Style="{StaticResource DefaultButtonStyle}"
                        ToolTipService.ToolTip="Entfernen" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- Ein Viewport: kein äußeres Scrollen; nur in Karten-Listen scrollen -->
    <Grid Padding="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="Fader-Zuordnung" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Zuordnungen werden automatisch gespeichert · Live-Audio pro Fader (Tooltip auf Überschrift)"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="UnsavedHintText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource MixrAccentBrush}"
                    Text="Ungespeichert"
                    Visibility="Collapsed" />
                <Button
                    Padding="14,8"
                    Click="ResetDraft_Click"
                    Content="Zurücksetzen"
                    Style="{StaticResource DefaultButtonStyle}" />
                <Button
                    x:Name="SaveDraftButton"
                    Padding="14,8"
                    Click="SaveDraft_Click"
                    Content="Speichern"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Bibliothek (kompakt, feste Höhe) -->
        <Border
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="12,10"
            Background="{ThemeResource MixrGameStripBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="Programm-Bibliothek" />
                    <Button
                        x:Name="ReloadCatalogButton"
                        Grid.Column="1"
                        Padding="10,6"
                        Click="ReloadCatalog_Click"
                        Content="Aktualisieren" />
                </Grid>
                <TextBlock
                    x:Name="CatalogHintText"
                    Grid.Row="1"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis" />
                <ScrollViewer
                    Grid.Row="2"
                    MaxHeight="168"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <ItemsControl x:Name="CatalogGamesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="120"
                                    Margin="0,0,8,0"
                                    Padding="8"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MixrGameStripBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CanDrag="True"
                                    CornerRadius="8"
                                    DragStarting="CatalogItem_DragStarting">
                                    <StackPanel Spacing="4">
                                        <Grid
                                            Width="96"
                                            Height="135"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="6">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="28"
                                                Foreground="{ThemeResource MixrAccentBrush}"
                                                Glyph="&#xE7FC;"
                                                Opacity="0.35"
                                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            <Image
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Source="{Binding Icon}"
                                                Stretch="UniformToFill"
                                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Padding="6,4"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Name}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                        </Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="10"
                                            MaxWidth="108"
                                            Text="{Binding Name}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Vier Fader-Spalten: gleiche Gesamtbreite wie Bibliothek, Resthöhe mit kleinem Rand -->
        <Grid
            Grid.Row="2"
            Margin="0,10,0,12"
            MinHeight="160">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="6.6*" />
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="6.6*" />
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="6.6*" />
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="FaderZone0"
                Grid.Column="0"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding LiveActivity}" />
                    <ScrollViewer
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="FaderZone1"
                Grid.Column="2"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding LiveActivity}" />
                    <ScrollViewer
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="FaderZone2"
                Grid.Column="4"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding LiveActivity}" />
                    <ScrollViewer
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="FaderZone3"
                Grid.Column="6"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding LiveActivity}" />
                    <ScrollViewer
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
