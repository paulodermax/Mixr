<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.SliderMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="AssignedGameTemplate">
            <Border
                Padding="8,6"
                Margin="0,0,0,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SliderCardTemplate">
            <Border
                Margin="0,0,16,16"
                Padding="18"
                AllowDrop="True"
                IsHitTestVisible="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border
                            Width="4"
                            Height="24"
                            VerticalAlignment="Center"
                            Background="{ThemeResource MixrAccentBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding Title}" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Spiel aus der Bibliothek hierher ziehen — Zuordnung wird in config.yaml gespeichert."
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="Zugeordnete Spiele" />
                    <ItemsControl ItemTemplate="{StaticResource AssignedGameTemplate}" ItemsSource="{Binding AssignedGames}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="28,20" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock FontSize="32" FontWeight="SemiBold" Text="Slider Mapping" />
                <TextBlock
                    MaxWidth="1000"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Bibliothek (links) auf Fader-Karten (rechts) ziehen. Es werden keine Windows-Audio-Sessions abgefragt — nur gespeicherte Zuordnungen."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Margin="0,22,0,0"
                Padding="20"
                Background="{ThemeResource MixrGameStripBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Spiele-Bibliothek" />
                        <Button
                            x:Name="ReloadCatalogButton"
                            Padding="12,8"
                            Click="ReloadCatalog_Click"
                            Content="Katalog jetzt aktualisieren" />
                    </StackPanel>
                    <TextBlock
                        x:Name="CatalogHintText"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                    <ListView
                        x:Name="CatalogGamesList"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Padding="0"
                        IsItemClickEnabled="False"
                        IsSwipeEnabled="False"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="96"
                                    Margin="0,0,12,0"
                                    Padding="10"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource MixrGameStripBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel Spacing="8">
                                        <Grid
                                            Width="72"
                                            Height="96"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="28"
                                                Foreground="{ThemeResource MixrAccentBrush}"
                                                Glyph="&#xE7FC;"
                                                Opacity="0.35" />
                                            <Image
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Source="{Binding Icon}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            MaxWidth="88"
                                            Text="{Binding Name}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Row="2" MinHeight="320" Margin="0,22,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Fader" />
                <ItemsControl
                    x:Name="SliderItems"
                    Grid.Row="1"
                    ItemTemplate="{StaticResource SliderCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid
                                ItemHeight="NaN"
                                ItemWidth="400"
                                MaximumRowsOrColumns="4"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
