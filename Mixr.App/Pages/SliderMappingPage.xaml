<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.SliderMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Mixr_App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="AssignedCoverTemplate">
            <Border
                Margin="0,0,6,6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                CanDrag="True"
                DragStarting="AssignedItem_DragStarting"
                DropCompleted="CoverTile_DropCompleted"
                Loaded="AssignedCover_Loaded"
                PointerEntered="AssignedCover_PointerEntered"
                PointerExited="AssignedCover_PointerExited">
                <ToolTipService.ToolTip>
                    <ToolTip Content="{Binding TooltipText}" />
                </ToolTipService.ToolTip>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MinHeight="40"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Grid IsHitTestVisible="False">
                        <Border
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{ThemeResource MixrSubtleFillBrush}"
                            CornerRadius="8"
                            Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="{ThemeResource MixrAccentBrush}"
                                Glyph="&#xE7FC;"
                                Opacity="0.45" />
                        </Border>
                        <Border CornerRadius="8">
                            <Image
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                Source="{Binding Cover}"
                                Stretch="Uniform"
                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Text="Slider-Editing" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Padding="14,8"
                    Click="ResetDraft_Click"
                    Content="Reset"
                    Style="{StaticResource DefaultButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Library: fixed content height -->
        <Border
            x:Name="LibraryPanel"
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="12,10"
            AllowDrop="True"
            Background="{ThemeResource MixrGameStripBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            DragEnter="LibraryDropZone_DragEnter"
            DragLeave="LibraryDropZone_DragLeave"
            DragOver="LibraryDropZone_DragOver"
            Drop="LibraryDropZone_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="168" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="Library" />
                    <TextBlock
                        x:Name="LibraryMetaText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="ReloadCatalogButton"
                        Grid.Column="2"
                        Padding="10,6"
                        Click="ReloadCatalog_Click"
                        Content="Refresh" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <ScrollViewer
                        x:Name="CatalogScrollViewer"
                        MaxHeight="168"
                        Height="168"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <ItemsControl x:Name="CatalogGamesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="120"
                                        Margin="0,0,8,0"
                                        Padding="8"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource MixrGameStripBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CanDrag="True"
                                        CornerRadius="8"
                                        DragStarting="CatalogItem_DragStarting"
                                        DropCompleted="CoverTile_DropCompleted"
                                        Loaded="CatalogCoverItem_Loaded">
                                        <StackPanel Spacing="4">
                                            <Grid
                                                Width="96"
                                                Height="135"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                CornerRadius="6">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="28"
                                                    Foreground="{ThemeResource MixrAccentBrush}"
                                                    Glyph="&#xE7FC;"
                                                    Opacity="0.35"
                                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                <Image
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Source="{Binding Icon}"
                                                    Stretch="Uniform"
                                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="6,4"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            </Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                MaxWidth="108"
                                                Text="{Binding Name}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        x:Name="LibraryEmptyText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsHitTestVisible="False"
                        Text="no more apps left."
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- Four slider columns -->
        <Grid
            Grid.Row="2"
            Margin="0,10,0,12"
            MinHeight="160">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="3.3*" />
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="3.3*" />
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="3.3*" />
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="FaderZone0"
                Grid.Column="0"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding LiveActivity}" />
                        <Button
                            Grid.Column="1"
                            Width="28"
                            Height="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SoundCurveMenu_Click"
                            ToolTipService.ToolTip="Sound-Mapping">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        HorizontalScrollMode="Disabled"
                        SizeChanged="AssignedScroller_SizeChanged"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        MaximumRowsOrColumns="3"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="FaderZone1"
                Grid.Column="2"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding LiveActivity}" />
                        <Button
                            Grid.Column="1"
                            Width="28"
                            Height="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SoundCurveMenu_Click"
                            ToolTipService.ToolTip="Sound-Mapping">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        HorizontalScrollMode="Disabled"
                        SizeChanged="AssignedScroller_SizeChanged"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        MaximumRowsOrColumns="3"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="FaderZone2"
                Grid.Column="4"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding LiveActivity}" />
                        <Button
                            Grid.Column="1"
                            Width="28"
                            Height="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SoundCurveMenu_Click"
                            ToolTipService.ToolTip="Sound-Mapping">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        HorizontalScrollMode="Disabled"
                        SizeChanged="AssignedScroller_SizeChanged"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        MaximumRowsOrColumns="3"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="FaderZone3"
                Grid.Column="6"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding LiveActivity}" />
                        <Button
                            Grid.Column="1"
                            Width="28"
                            Height="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SoundCurveMenu_Click"
                            ToolTipService.ToolTip="Sound-Mapping">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        HorizontalScrollMode="Disabled"
                        SizeChanged="AssignedScroller_SizeChanged"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        MaximumRowsOrColumns="3"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
