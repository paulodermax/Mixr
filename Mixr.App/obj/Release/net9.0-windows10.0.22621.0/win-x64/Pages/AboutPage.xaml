<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Mixr_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16">
        <StackPanel MaxWidth="720">
            <TextBlock
                Margin="0,0,0,8"
                FontSize="22"
                FontWeight="SemiBold"
                Text="Mixr" />
            <TextBlock
                Margin="0,0,0,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Desktop-Bridge zwischen ESP-Mixr und Windows: Medieninfo, Lautstärke-Gruppen, serielles Protokoll."
                TextWrapping="Wrap" />
            <TextBlock Text="WinUI 3 · Infobereich · optional sichtbar" />
        </StackPanel>
    </ScrollViewer>
</Page>

