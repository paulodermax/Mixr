<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock FontSize="32" FontWeight="SemiBold" Text="Übersicht" />
                <TextBlock
                    MaxWidth="900"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Schneller Status und Konfiguration. Der Spiele-Katalog wird im Hintergrund verwaltet (wöchentlich/täglich) — ohne Audio-Session-Abfragen."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Width="4"
                                Height="22"
                                VerticalAlignment="Center"
                                Background="{ThemeResource MixrAccentBrush}"
                                CornerRadius="2" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Status" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Mixr läuft im Hintergrund (Serial, Host). Diese Seite fragt keine Geräte- oder Session-Daten ab."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Width="4"
                                Height="22"
                                VerticalAlignment="Center"
                                Background="{ThemeResource MixrAccentBrush}"
                                CornerRadius="2" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Konfiguration" />
                        </StackPanel>
                        <TextBlock x:ConnectionId='3'
                            x:Name="ConfigPathText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Padding="22"
                    Background="{ThemeResource MixrGameStripBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Slider &amp; Spiele" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Spiele aus dem Katalog auf die Fader-Karten ziehen — Zuordnung in config.yaml (Host lädt neu)."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <Button x:ConnectionId='2'
                            Grid.Column="1"
                            MinWidth="200"
                            Padding="18,12"
                            VerticalAlignment="Center"
                                                           
                            Content="Slider Mapping öffnen"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

