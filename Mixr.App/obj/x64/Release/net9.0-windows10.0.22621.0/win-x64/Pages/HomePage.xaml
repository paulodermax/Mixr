<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Mixr_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720">
            <TextBlock
                Margin="0,0,0,12"
                FontSize="22"
                FontWeight="SemiBold"
                Text="Übersicht" />
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Mixr läuft im Infobereich und verbindet dein Gerät mit Windows (Medien, Lautstärke, Discord-Hotkeys). Schließen blendet nur das Fenster aus — Beenden geht über das Tray-Icon."
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,12"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Konfiguration" />
                    <TextBlock x:ConnectionId='2' x:Name="ConfigPathText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Hinweise" />
                    <TextBlock
                        Margin="0,0,0,6"
                        Text="• Slider 1-4: Main, Kommunikation, Media, Spiele (session_groups in config.yaml)"
                        TextWrapping="Wrap" />
                    <TextBlock Text="• Tasten / Discord-Hotkeys wie in der Firmware-Doku" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

