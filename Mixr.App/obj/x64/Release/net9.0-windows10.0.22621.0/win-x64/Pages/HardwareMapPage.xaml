<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.HardwareMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Schematic: volle Fläche unter der Navigation -->
        <Grid x:ConnectionId='2' x:Name="SchematicRoot" Padding="8">
            <Grid.RenderTransform>
                <TranslateTransform x:ConnectionId='14' x:Name="SchematicSlideTransform" />
            </Grid.RenderTransform>
            <Viewbox x:ConnectionId='15'
                x:Name="SchematicViewbox"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="Uniform">
                <Canvas Width="1023" Height="792">
                    <Image x:ConnectionId='16' x:Name="SchematicImage" Width="1023" Height="792" />

                    <Grid x:ConnectionId='17'
                        Canvas.Left="420"
                        Canvas.Top="242"
                        Width="58"
                        Height="504"
                        Background="Transparent"
                                                               
                                                             
                                               
                        Tag="f0">
                        <Border x:ConnectionId='34'
                            x:Name="GlowF0"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid x:ConnectionId='18'
                        Canvas.Left="571"
                        Canvas.Top="242"
                        Width="58"
                        Height="504"
                        Background="Transparent"
                                                               
                                                             
                                               
                        Tag="f1">
                        <Border x:ConnectionId='33'
                            x:Name="GlowF1"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid x:ConnectionId='19'
                        Canvas.Left="722"
                        Canvas.Top="242"
                        Width="58"
                        Height="504"
                        Background="Transparent"
                                                               
                                                             
                                               
                        Tag="f2">
                        <Border x:ConnectionId='32'
                            x:Name="GlowF2"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid x:ConnectionId='20'
                        Canvas.Left="873"
                        Canvas.Top="242"
                        Width="58"
                        Height="504"
                        Background="Transparent"
                                                               
                                                             
                                               
                        Tag="f3">
                        <Border x:ConnectionId='31'
                            x:Name="GlowF3"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>

                    <Grid x:ConnectionId='21'
                        Canvas.Left="61"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                                                               
                                                             
                                               
                        Tag="b0">
                        <Border x:ConnectionId='30'
                            x:Name="GlowB0"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid x:ConnectionId='22'
                        Canvas.Left="209"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                                                               
                                                             
                                               
                        Tag="b1">
                        <Border x:ConnectionId='29'
                            x:Name="GlowB1"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid x:ConnectionId='23'
                        Canvas.Left="359"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                                                               
                                                             
                                               
                        Tag="b2">
                        <Border x:ConnectionId='28'
                            x:Name="GlowB2"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid x:ConnectionId='24'
                        Canvas.Left="559"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                                                               
                                                             
                                               
                        Tag="b3">
                        <Border x:ConnectionId='27'
                            x:Name="GlowB3"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <Grid x:ConnectionId='25'
                        Canvas.Left="708"
                        Canvas.Top="70"
                        Width="92"
                        Height="92"
                        Background="Transparent"
                                                               
                                                             
                                               
                        Tag="b4">
                        <Border x:ConnectionId='26'
                            x:Name="GlowB4"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MixrAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                </Canvas>
            </Viewbox>
        </Grid>

        <Border x:ConnectionId='3'
            x:Name="DetailDrawer"
            Width="380"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:ConnectionId='4' x:Name="DetailSlideTransform" />
            </Border.RenderTransform>
            <Grid Padding="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:ConnectionId='12'
                        x:Name="DetailTitleText"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <Button x:ConnectionId='13'
                        Grid.Column="1"
                        Padding="10,6"
                                                 
                        Content="Schließen"
                        Style="{StaticResource DefaultButtonStyle}" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
                    <Grid>
                        <StackPanel x:ConnectionId='5' x:Name="SliderDetailPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Audio-Gruppe (Key)" />
                            <TextBox x:ConnectionId='9'
                                x:Name="DetailSliderGroup"
                                PlaceholderText="z. B. communication" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Suchstrings (eine Zeile pro Eintrag)" />
                            <TextBox x:ConnectionId='10'
                                x:Name="DetailSliderPrograms"
                                MinHeight="180"
                                AcceptsReturn="True"
                                PlaceholderText="App- oder Fenstitel"
                                TextWrapping="Wrap" />
                            <Button x:ConnectionId='11'
                                HorizontalAlignment="Stretch"
                                                              
                                Content="Speichern"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                        <StackPanel x:ConnectionId='6' x:Name="ButtonDetailPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock
                                Text="Aktion beim Drücken (button_mapping in config.yaml)"
                                TextWrapping="WrapWholeWords"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:ConnectionId='7' x:Name="DetailButtonCombo" HorizontalAlignment="Stretch" />
                            <Button x:ConnectionId='8'
                                HorizontalAlignment="Stretch"
                                                              
                                Content="Speichern"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

