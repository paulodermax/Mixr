<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Mixr_App.Pages.SliderMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Mixr_App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="AssignedCoverTemplate">
            <Border x:ConnectionId='2'
                Margin="0,0,6,6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                CanDrag="True"
                                                        
                                             
                                                           
                                                             
                                                           
                                                         
                                                           >
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MinHeight="40"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Grid>
                        <Border
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{ThemeResource MixrSubtleFillBrush}"
                            CornerRadius="8"
                            Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="{ThemeResource MixrAccentBrush}"
                                Glyph="&#xE7FC;"
                                Opacity="0.45" />
                        </Border>
                        <Border CornerRadius="8">
                            <Image
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Source="{Binding Cover}"
                                Stretch="Uniform"
                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Text="Slider-Editing" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock x:ConnectionId='18'
                    x:Name="UnsavedHintText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource MixrAccentBrush}"
                    Text="Unsaved"
                    Visibility="Collapsed" />
                <Button x:ConnectionId='19'
                    Padding="14,8"
                                            
                    Content="Reset"
                    Style="{StaticResource DefaultButtonStyle}" />
                <Button x:ConnectionId='20'
                    x:Name="SaveDraftButton"
                    Padding="14,8"
                                           
                    Content="Save"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Library: fixed content height -->
        <Border x:ConnectionId='3'
            x:Name="LibraryPanel"
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="12,10"
            AllowDrop="True"
            Background="{ThemeResource MixrGameStripBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
                                                 
                                                 
                                               
                                       >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="168" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="Library" />
                    <TextBlock x:ConnectionId='16'
                        x:Name="LibraryMetaText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <Button x:ConnectionId='17'
                        x:Name="ReloadCatalogButton"
                        Grid.Column="2"
                        Padding="10,6"
                                                   
                        Content="Refresh" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <ScrollViewer x:ConnectionId='12'
                        x:Name="CatalogScrollViewer"
                        MaxHeight="168"
                        Height="168"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <ItemsControl x:ConnectionId='14' x:Name="CatalogGamesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:ConnectionId='15'
                                        Width="120"
                                        Margin="0,0,8,0"
                                        Padding="8"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource MixrGameStripBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CanDrag="True"
                                        CornerRadius="8"
                                                                               
                                                                        
                                                                                   
                                                                                 
                                                                                   >
                                        <StackPanel Spacing="4">
                                            <Grid
                                                Width="96"
                                                Height="135"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                CornerRadius="6">
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="28"
                                                    Foreground="{ThemeResource MixrAccentBrush}"
                                                    Glyph="&#xE7FC;"
                                                    Opacity="0.35"
                                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                <Image
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Source="{Binding Icon}"
                                                    Stretch="Uniform"
                                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="6,4"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            </Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                MaxWidth="108"
                                                Text="{Binding Name}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:ConnectionId='13'
                        x:Name="LibraryEmptyText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsHitTestVisible="False"
                        Text="no more apps left."
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- Four slider columns -->
        <Grid
            Grid.Row="2"
            Margin="0,10,0,12"
            MinHeight="160">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="3.3*" />
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="3.3*" />
                <ColumnDefinition Width="20*" />
                <ColumnDefinition Width="3.3*" />
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>

            <Border x:ConnectionId='4'
                x:Name="FaderZone0"
                Grid.Column="0"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                                              
                                              
                                            
                                    >
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding LiveActivity}" />
                    <ScrollViewer x:ConnectionId='11'
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                                                      
                                                      
                                                    
                                            
                        HorizontalScrollMode="Disabled"
                                                                  
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        MaximumRowsOrColumns="3"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:ConnectionId='5'
                x:Name="FaderZone1"
                Grid.Column="2"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                                              
                                              
                                            
                                    >
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding LiveActivity}" />
                    <ScrollViewer x:ConnectionId='10'
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                                                      
                                                      
                                                    
                                            
                        HorizontalScrollMode="Disabled"
                                                                  
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        MaximumRowsOrColumns="3"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:ConnectionId='6'
                x:Name="FaderZone2"
                Grid.Column="4"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                                              
                                              
                                            
                                    >
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding LiveActivity}" />
                    <ScrollViewer x:ConnectionId='9'
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                                                      
                                                      
                                                    
                                            
                        HorizontalScrollMode="Disabled"
                                                                  
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        MaximumRowsOrColumns="3"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:ConnectionId='7'
                x:Name="FaderZone3"
                Grid.Column="6"
                Padding="10,8,10,10"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                                              
                                              
                                            
                                    >
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding LiveActivity}" />
                    <ScrollViewer x:ConnectionId='8'
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                                                      
                                                      
                                                    
                                            
                        HorizontalScrollMode="Disabled"
                                                                  
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <ItemsControl ItemTemplate="{StaticResource AssignedCoverTemplate}" ItemsSource="{Binding AssignedPrograms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        HorizontalAlignment="Stretch"
                                        MaximumRowsOrColumns="3"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

