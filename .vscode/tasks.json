{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mixr-build-debug",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Mixr.App/Mixr.App.csproj",
        "-c",
        "Debug",
        "-r",
        "win-x64"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "mixr-watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/Mixr.App/Mixr.App.csproj",
        "-c",
        "Debug",
        "-r",
        "win-x64"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
